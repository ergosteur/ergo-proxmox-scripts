# Install as /etc/nut/upsmon.conf (root:nut, 0640).
#
# This machine owns the UPS, so it is the primary: it shuts down last, after
# secondaries such as the Synology have been told to go.
#
# Replace CHANGEME with the [admin] password from upsd.users. The two must match
# or upsmon cannot log in to its own upsd.

RUN_AS_USER nut

MONITOR ups@localhost 1 admin CHANGEME primary

MINSUPPLIES 1
SHUTDOWNCMD "/sbin/shutdown -h +0"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
POWERDOWNFLAG /etc/killpower
FINALDELAY 5
