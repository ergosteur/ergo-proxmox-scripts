#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["textual>=8"]
# ///
"""Terminal dashboard for Dell PowerEdge / iDRAC fan control.

Shows live temperatures and fan RPMs, and lets you take the fans over by hand:

  Hands off   send nothing; whatever is in control (the daemon, the BMC) stays so
  BMC auto    force the BMC's automatic curve
  Manual      pin all fans to a duty you choose with the slider or buttons

While you are in BMC auto or Manual this writes its PID to the override file, so
ipmi-fancontrol-daemon stands down instead of fighting you. If this program dies,
the PID goes stale and the daemon resumes by itself within one poll.

Manual mode has no thermal response. It drops back to BMC auto if a CPU reaches
CPU_TEMP_THRESHOLD or the temperatures cannot be read, and on quit.

Reads conf/ipmi-fancontrol.conf like the shell scripts do. Needs root for the local
"open" interface. Run it directly (uv fetches Textual on first use):

    ./ipmi-fancontrol-tui           the dashboard
    ./ipmi-fancontrol-tui --check   print one reading and exit; changes nothing
"""

from __future__ import annotations

import asyncio
import atexit
import os
import re
import signal
import sys
import time
from dataclasses import dataclass
from pathlib import Path

# ---------------------------------------------------------------------------
# Configuration, ipmitool, parsing. No Textual in this half, so --check works
# (and can be tested) without the UI.
# ---------------------------------------------------------------------------

MIN_DUTY = 5  # percent; below this some fans stall
MAX_DUTY = 100
REASSERT_EVERY = 15.0  # seconds; the BMC has been seen to drop manual mode silently
SENSOR_FAILS_BEFORE_FALLBACK = 3


@dataclass
class Config:
    interface: str = "open"
    host: str = ""
    user: str = ""
    password: str = ""
    fan_speed: int = 21  # percent, from FAN_SPEED=0x15
    threshold: int = 70
    override_file: Path = Path("/run/ipmi-fancontrol.override")
    service: str = "ipmi-fancontrol"
    source: str = "defaults (no config found)"


def parse_conf(text: str) -> dict[str, str]:
    """Read KEY=VALUE lines from the shell config without executing it."""
    out: dict[str, str] = {}
    for line in text.splitlines():
        m = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
        if not m:
            continue
        value = m.group(2).strip()
        if value[:1] in "\"'":
            end = value.find(value[0], 1)
            value = value[1:end] if end > 0 else value[1:]
        else:
            value = re.split(r"\s+#", value, maxsplit=1)[0].strip()
        out[m.group(1)] = value
    return out


def load_config() -> Config:
    here = Path(__file__).resolve().parent
    path = Path(os.environ.get("IPMI_FANCONTROL_CONFIG", here / "conf/ipmi-fancontrol.conf"))
    cfg = Config()
    try:
        conf = parse_conf(path.read_text())
    except OSError:
        return cfg
    cfg.source = str(path)
    cfg.interface = conf.get("IPMI_INTERFACE", cfg.interface)
    cfg.host = conf.get("IPMI_HOST", "")
    cfg.user = conf.get("IPMI_USER", "")
    cfg.password = conf.get("IPMI_PASSWORD", "")
    try:
        cfg.fan_speed = int(conf.get("FAN_SPEED", str(cfg.fan_speed)), 0)
    except ValueError:
        pass
    try:
        cfg.threshold = int(conf.get("CPU_TEMP_THRESHOLD", str(cfg.threshold)))
    except ValueError:
        pass
    if "OVERRIDE_FILE" in conf:
        cfg.override_file = Path(conf["OVERRIDE_FILE"])
    return cfg


class Ipmi:
    """Thin async wrapper around ipmitool, built the way the shell scripts do."""

    def __init__(self, cfg: Config) -> None:
        self.env = os.environ.copy()
        if cfg.interface == "lanplus":
            # -E reads the password from the environment, keeping it out of argv.
            self.base = ["ipmitool", "-I", "lanplus", "-H", cfg.host, "-U", cfg.user, "-E"]
            self.env["IPMI_PASSWORD"] = cfg.password
        else:
            self.base = ["ipmitool", "-I", "open"]

    async def run(self, *args: str, timeout: float = 20.0) -> tuple[int, str]:
        try:
            proc = await asyncio.create_subprocess_exec(
                *self.base,
                *args,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                env=self.env,
            )
        except FileNotFoundError:
            return 127, "ipmitool not found"
        try:
            out, err = await asyncio.wait_for(proc.communicate(), timeout)
        except asyncio.TimeoutError:
            proc.kill()
            await proc.wait()
            return 124, "ipmitool timed out"
        rc = proc.returncode or 0
        return rc, (out if rc == 0 else err or out).decode(errors="replace").strip()


@dataclass
class Reading:
    label: str
    entity: str
    status: str
    value: int | None  # degrees C or RPM; None when there is no numeric reading
    text: str


def parse_sdr(text: str) -> list[Reading]:
    """Parse `ipmitool sdr type ...` rows: name | id | status | entity | reading."""
    rows: list[Reading] = []
    for line in text.splitlines():
        parts = [p.strip() for p in line.split("|")]
        if len(parts) < 5:
            continue
        name, _id, status, entity, reading = parts[:5]
        m = re.search(r"-?\d+", reading)
        value = int(m.group()) if m and re.search(r"degrees C|RPM", reading) else None
        label = name
        if entity.startswith("3.") and name == "Temp":  # CPU sensors are entity 3.x
            label = f"CPU{entity.split('.')[1]}"
        rows.append(Reading(label, entity, status, value, reading))
    return rows


def max_cpu_temp(temps: list[Reading]) -> int | None:
    vals = [r.value for r in temps if r.entity.startswith("3.") and r.value is not None]
    return max(vals) if vals else None


def duty_hex(percent: int) -> str:
    return f"0x{percent:02x}"


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def read_pid(path: Path) -> int | None:
    try:
        return int(path.read_text().split()[0])
    except (OSError, ValueError, IndexError):
        return None


async def check() -> int:
    cfg = load_config()
    ipmi = Ipmi(cfg)
    print(f"config:    {cfg.source}")
    print(f"interface: {cfg.interface}   threshold: {cfg.threshold}C   default duty: {cfg.fan_speed}%")
    pid = read_pid(cfg.override_file)
    held = f"held by PID {pid}{'' if pid and pid_alive(pid) else ' (stale)'}" if pid else "none"
    print(f"override:  {held}")
    (rc_t, out_t), (rc_f, out_f) = await asyncio.gather(
        ipmi.run("sdr", "type", "temperature"), ipmi.run("sdr", "type", "fan")
    )
    if rc_t or rc_f:
        print(f"ipmitool failed: {out_t if rc_t else out_f}", file=sys.stderr)
        return 1
    for r in parse_sdr(out_t) + parse_sdr(out_f):
        print(f"  {r.label:<16} {r.text}")
    return 0


if __name__ == "__main__" and "--check" in sys.argv:
    sys.exit(asyncio.run(check()))
if __name__ == "__main__" and any(a in sys.argv for a in ("-h", "--help")):
    print(__doc__)
    sys.exit(0)

