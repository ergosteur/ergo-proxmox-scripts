    def __init__(self, cfg: Config | None = None, poll_interval: float = 2.0) -> None:
        super().__init__()
        self.cfg = cfg or load_config()
        self.ipmi = Ipmi(self.cfg)
        self.poll_interval = poll_interval
        self.mode = "daemon"
        self.temps: list[Reading] = []
        self.fans: list[Reading] = []
        self.max_cpu: int | None = None
        self.sensor_fails = 0
        self.max_rpm_seen = 5000
        self.service_state = "?"
        self._service_checked = 0.0
        self._last_write = 0.0
        self._lock = asyncio.Lock()
        self._apply_timer = None
        self._quitting = False
        self._svc_busy = False
        self.compact = False  # collapse the temperature and fan boxes to one coloured line each
        self.hold_pct = min(max(self.cfg.fan_speed, MIN_DUTY), MAX_DUTY)  # daemon's FAN_SPEED
        self.hold_pending = False  # a hold speed was saved and the service has not restarted since
        self._conf_mtime: float | None = None
        self._svc_started: float | None = None
        atexit.register(self._atexit_cleanup)

    # -- layout -----------------------------------------------------------

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        yield Static(id="status")
        with Horizontal(id="panels"):
            yield Panel(id="temps")
            yield Panel(id="fans")
        with Vertical(id="controls"):
            with Horizontal(id="modes"):
                with Horizontal(id="auto-group"):
                    yield Button("Daemon control", id="mode-daemon")
                    yield Button("BMC control", id="mode-bmc")
                yield Button("Manual", id="mode-manual")
                yield Static(id="modes-spacer")
                with Horizontal(id="daemon-group"):
                    yield Button("STOP", id="svc-toggle")
                    yield Button("RESTART", id="svc-restart")
                    yield Button("Set hold", id="hold-save")
            yield Slider(min(max(self.cfg.fan_speed, MIN_DUTY), MAX_DUTY), id="slider")
            with Horizontal(id="presets"):
                yield Button("-5", id="bump-down")
                yield Button("+5", id="bump-up")
                for pct in (10, 20, 30, 50, 100):
                    yield Button(f"{pct}%", id=f"preset-{pct}")
        yield RichLog(id="log", wrap=True, markup=False, highlight=False)
        yield Footer()

    def on_mount(self) -> None:
        self.sub_title = f"{self.cfg.interface}  threshold {self.cfg.threshold}C"
        self.query_one("#auto-group").border_title = "AUTO"
        self.query_one("#daemon-group").border_title = "FAN CONTROL DAEMON"
        self.note(f"config: {self.cfg.source}")
        self._refresh_all()
        self.query_one("#slider", Slider).focus()
        self.run_worker(self._poll_loop(), exclusive=True)
        loop = asyncio.get_running_loop()
        for sig in (signal.SIGTERM, signal.SIGHUP):
            try:
                loop.add_signal_handler(sig, lambda: asyncio.ensure_future(self.action_quit()))
            except (NotImplementedError, RuntimeError, ValueError):
                pass

    # -- small helpers ----------------------------------------------------

    @property
    def slider(self) -> Slider:
        return self.query_one("#slider", Slider)

    def note(self, message: str) -> None:
        self.query_one("#log", RichLog).write(f"{time.strftime('%H:%M:%S')}  {message}")

    # -- override file (so the daemon stands down) ------------------------

    def claim(self) -> bool:
        path = self.cfg.override_file
        holder = read_pid(path)
        if holder and holder != os.getpid() and pid_alive(holder):
            self.note(f"override already held by PID {holder}; not taking over")
            return False
        try:
            tmp = path.with_name(path.name + ".tmp")
            tmp.write_text(f"{os.getpid()}\n")
            os.replace(tmp, path)
        except OSError as exc:
            self.note(f"cannot write override file {path}: {exc}")
            return False
        return True

    def _release_sync(self) -> None:
        path = self.cfg.override_file
        if read_pid(path) == os.getpid():
            try:
                path.unlink()
            except OSError:
                pass

    def _atexit_cleanup(self) -> None:
        """Last resort for a crash or unhandled exception: never leave the fans
        pinned. A normal quit has already done this and set the mode back."""
        if self.mode == "manual":
            try:
                subprocess.run(
                    [*self.ipmi.base, "raw", "0x30", "0x30", "0x01", "0x01"],
                    env=self.ipmi.env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    timeout=15, check=False,
                )
            except (OSError, subprocess.SubprocessError):
                pass
        self._release_sync()

    # -- talking to the BMC ----------------------------------------------

    async def send_auto(self) -> bool:
        rc, out = await self.ipmi.run("raw", "0x30", "0x30", "0x01", "0x01")
        self._last_write = time.monotonic()
        if rc:
            self.note(f"failed to hand fans to the BMC: {out}")
        return rc == 0

    async def send_manual(self) -> bool:
        pct = self.slider.value
        rc, out = await self.ipmi.run("raw", "0x30", "0x30", "0x01", "0x00")
        if rc == 0:
            rc, out = await self.ipmi.run("raw", "0x30", "0x30", "0x02", "0xff", duty_hex(pct))
        self._last_write = time.monotonic()
        if rc:
            self.note(f"failed to set manual fan speed: {out}")
        return rc == 0

    async def set_mode(self, new: str, *, require_daemon: bool = True) -> None:
        async with self._lock:
            old = self.mode
            if new == old:
                return
            if new == "daemon":
                if require_daemon and self.service_state != "active":
                    self.note("daemon control needs the daemon running: use START below")
                    self.notify("The daemon is not running: START it first", severity="warning")
                    return
                if old == "manual" and not await self.send_auto():
                    return
                self._release_sync()
                self.mode = "daemon"
                if self._apply_timer is not None:
                    self._apply_timer.stop()
                # Show the daemon's own hold speed. Set after the mode, and
                # programmatically, so it neither re-applies nor flips back to Manual.
                self.slider.value = self.hold_pct
                self.note(f"daemon control: the daemon resumes within one poll (hold speed {self.hold_pct}%)")
            else:
                if new == "manual" and (self.max_cpu is None or self.max_cpu >= self.cfg.threshold):
                    shown = "unknown" if self.max_cpu is None else f"{self.max_cpu}C"
                    self.note(f"refusing manual mode: CPU temperature is {shown}")
                    self.notify("Manual refused: CPU temperature unknown or too high", severity="warning")
                    return
                if not self.claim():
                    return
                ok = await (self.send_auto() if new == "bmc" else self.send_manual())
                if not ok:
                    if old == "daemon":
                        self._release_sync()
                    return
                self.mode = new
                if new == "manual":
                    self.note(f"manual: all fans pinned to {self.slider.value}%")
                else:
                    self.note("BMC control: the daemon is standing down")
        self._refresh_all()

    async def fall_back(self, reason: str) -> None:
        async with self._lock:
            if self.mode != "manual":
                return
            self.mode = "bmc"
            await self.send_auto()
        self.note(f"SAFETY: {reason}; handed the fans to the BMC")
        self.notify(f"{reason}: back to BMC control", severity="error", timeout=10)
        self._refresh_all()

    async def _apply_speed(self) -> None:
        if self.mode != "manual":
            return
        async with self._lock:
            if self.mode == "manual" and await self.send_manual():
                self.note(f"fans set to {self.slider.value}%")

    async def _release_and_stop(self) -> None:
        if self._quitting:
            return
        self._quitting = True
        async with self._lock:
            if self.mode == "manual":
                await self.send_auto()
            self._release_sync()
            self.mode = "daemon"

    async def action_quit(self) -> None:
        await self._release_and_stop()
        self.exit()

    # -- polling ----------------------------------------------------------

    async def _poll_loop(self) -> None:
        while True:
            await self.poll()
            await asyncio.sleep(self.poll_interval)

    async def poll(self) -> None:
        (rc_t, out_t), (rc_f, out_f) = await asyncio.gather(
            self.ipmi.run("sdr", "type", "temperature"), self.ipmi.run("sdr", "type", "fan")
        )
        if rc_f == 0:
            self.fans = parse_sdr(out_f)
            rpms = [r.value for r in self.fans if r.value is not None]
            self.max_rpm_seen = max([self.max_rpm_seen, *rpms])
        if rc_t == 0:
            self.temps = parse_sdr(out_t)
            self.max_cpu = max_cpu_temp(self.temps)
        else:
            self.max_cpu = None
        if self.max_cpu is None:
            self.sensor_fails += 1
        else:
            self.sensor_fails = 0
        if time.monotonic() - self._service_checked > 5:
            self._service_checked = time.monotonic()
            self.service_state = await self._service_state()
            self._svc_started = await self._service_started()
        self._reload_hold()
        self._refresh_all()

        if self.mode == "manual":
            if self.max_cpu is not None and self.max_cpu >= self.cfg.threshold:
                await self.fall_back(f"CPU at {self.max_cpu}C, at or above {self.cfg.threshold}C")
            elif self.sensor_fails >= SENSOR_FAILS_BEFORE_FALLBACK:
                await self.fall_back("cannot read CPU temperature")
            elif time.monotonic() - self._last_write >= REASSERT_EVERY:
                # No way to read the mode back, so re-send it in case the BMC dropped it.
                async with self._lock:
                    if self.mode == "manual":
                        await self.send_manual()

    async def _systemctl(self, *args: str, timeout: float = 30.0) -> tuple[int, str]:
        try:
            proc = await asyncio.create_subprocess_exec(
                "systemctl", *args,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
            )
        except OSError:
            return 127, "systemctl not found"
        try:
            out, err = await asyncio.wait_for(proc.communicate(), timeout)
        except asyncio.TimeoutError:
            proc.kill()
            await proc.wait()
            return 124, "systemctl timed out"
        return proc.returncode or 0, (out or err).decode(errors="replace").strip()

    async def _service_state(self) -> str:
        rc, out = await self._systemctl("is-active", self.cfg.service, timeout=5)
        if rc == 127:
            return "n/a"
        return (out.splitlines() or ["unknown"])[0]

    async def _service_started(self) -> float | None:
        """Unix time the service last became active, or None if unknown."""
        rc, out = await self._systemctl(
            "show", "-p", "ActiveEnterTimestamp", "--timestamp=unix", self.cfg.service, timeout=5
        )
        m = re.search(r"=@(\d+)", out) if rc == 0 else None
        return float(m.group(1)) if m else None

    def _reload_hold(self) -> None:
        """Pick up FAN_SPEED from disk, so edits made by hand show up too."""
        path = self.cfg.path
        if path is None:
            return
        try:
            mtime = path.stat().st_mtime
            if mtime == self._conf_mtime:
                return
            conf = parse_conf(path.read_text())
        except OSError:
            return
        self._conf_mtime = mtime
        old = self.hold_pct
        try:
            self.hold_pct = min(max(int(conf.get("FAN_SPEED", str(old)), 0), MIN_DUTY), MAX_DUTY)
        except ValueError:
            return
        if self.hold_pct != old and self.mode == "daemon":
            self.slider.value = self.hold_pct  # programmatic: does not switch to Manual

    @property
    def hold_unapplied(self) -> bool:
        """True if the config on disk is newer than the running daemon."""
        if self.hold_pending:
            return True
        return bool(self._conf_mtime and self._svc_started and self._conf_mtime > self._svc_started + 1)

    async def save_hold(self) -> None:
        path = self.cfg.path
        if path is None:
            self.note("no config file to edit; copy conf/ipmi-fancontrol.conf.example first")
            return
        pct = self.slider.value
        try:
            await asyncio.to_thread(save_fan_speed, path, pct)
        except OSError as exc:
            self.note(f"cannot save the hold speed to {path}: {exc}")
            self.notify("Could not save the hold speed", severity="error")
            return
        self.hold_pct = pct
        self.cfg.fan_speed = pct
        self.hold_pending = True
        try:
            self._conf_mtime = path.stat().st_mtime
        except OSError:
            pass
        self.note(f"saved FAN_SPEED={duty_hex(pct)} ({pct}%) to {path.name}; restart the service to apply")
        self.notify(f"Hold speed {pct}% saved: restart the service to apply")
        self._refresh_all()

    async def _refresh_service(self) -> None:
        self._service_checked = time.monotonic()
        self.service_state = await self._service_state()
        self._svc_started = await self._service_started()
        self._refresh_all()

    async def service_action(self, action: str) -> None:
        if self._svc_busy:
            return
        self._svc_busy = True
        try:
            if action == "start" and self.mode != "daemon":
                # Otherwise the daemon would start and immediately stand down.
                await self.set_mode("daemon", require_daemon=False)
                if self.mode != "daemon":
                    return
            self.note(f"systemctl {action} {self.cfg.service} ...")
            rc, out = await self._systemctl(action, self.cfg.service)
            if rc:
                self.note(f"systemctl {action} failed: {out}")
                self.notify(f"systemctl {action} failed", severity="error")
            else:
                self.note(f"systemctl {action}: done")
                if action in ("start", "restart"):
                    self.hold_pending = False
            # The daemon's own stop path hands the fans to the BMC. If we are
            # holding manual, put it straight back rather than wait for the re-send.
            if self.mode == "manual":
                async with self._lock:
                    if self.mode == "manual":
                        await self.send_manual()
            await self._refresh_service()
        finally:
            self._svc_busy = False
            self._refresh_all()

    # -- rendering --------------------------------------------------------

    def _temp_style(self, r: Reading) -> str:
        v = r.value or 0
        if r.entity.startswith("3."):
            hot, warm = self.cfg.threshold, self.cfg.threshold - 15
        else:
            hot, warm = 45, 35
        return "red" if v >= hot else "yellow" if v >= warm else "green"

    def _temps_full(self, bar_w: int) -> Text:
        t = Text("▾ Temperatures\n", style="bold")
        if not self.temps:
            t.append("  waiting for sensors...", style="grey50")
        for r in self.temps:
            if r.value is None:
                t.append(f"  {r.label:<10} {r.text}\n", style="grey50")
                continue
            t.append(f"  {r.label:<10} ")
            t.append(bar(r.value / 100, bar_w), style=self._temp_style(r))
            t.append(f" {r.value:>3}°C\n")
        return t

    def _fans_full(self, bar_w: int) -> Text:
        f = Text("▾ Fans\n", style="bold")
        if not self.fans:
            f.append("  waiting for sensors...", style="grey50")
        for r in self.fans:
            if r.value is None:
                style = "green" if r.status == "ok" else "red"
                f.append(f"  {r.label:<14} {r.text}\n", style=style)
                continue
            f.append(f"  {r.label:<8} ")
            f.append(bar(r.value / self.max_rpm_seen, bar_w), style="cyan" if r.status == "ok" else "red")
            f.append(f" {r.value:>5} RPM\n")
        return f

    def _temps_compact(self) -> Text:
        """One line, colour-coded the same way as the bars: green, yellow, red."""
        t = Text("▸ Temps  ", style="bold")
        if not self.temps:
            t.append("waiting for sensors...", style="grey50")
        for r in self.temps:
            if r.value is None:
                t.append(f"{r.label} {r.text}  ", style="grey50")
                continue
            t.append(f"{r.label} ")
            t.append(f"{r.value}°C", style=self._temp_style(r))
            t.append("  ")
        return t

    def _fans_compact(self) -> Text:
        """One line: the RPMs in order (cyan, or red and named if a fan is unhealthy),
        then any status rows such as redundancy (green, or red)."""
        f = Text("▸ Fans  ", style="bold")
        if not self.fans:
            f.append("waiting for sensors...", style="grey50")
        rpms = [r for r in self.fans if r.value is not None]
        for r in rpms:
            if r.status == "ok":
                f.append(f"{r.value} ", style="cyan")
            else:
                f.append(f"{r.label}:{r.value} ", style="bold red")
        if rpms:
            f.append("RPM", style="grey62")
        for r in self.fans:
            if r.value is None:
                f.append(f"  {r.label.removeprefix('Fan ')}: {r.text}", style="green" if r.status == "ok" else "red")
        return f

    def action_toggle_compact(self) -> None:
        self.compact = not self.compact
        self.query_one("#panels").set_class(self.compact, "compact")
        self._refresh_all()

    def _refresh_all(self) -> None:
        # Panels. Size the bars to what is left of each half-width panel after the
        # label and the reading, so nothing wraps on an 80-column terminal.
        narrow = self.size.width < NARROW_BELOW
        gap = "\u00a0" * (2 if narrow else 4)
        panel_w = self.query_one("#temps", Static).content_size.width or max(self.size.width // 2 - 4, 20)
        tbar = max(6, min(24, panel_w - 20))
        fbar = max(6, min(24, panel_w - 22))
        if self.compact:
            self.query_one("#temps", Static).update(self._temps_compact())
            self.query_one("#fans", Static).update(self._fans_compact())
        else:
            self.query_one("#temps", Static).update(self._temps_full(tbar))
            self.query_one("#fans", Static).update(self._fans_full(fbar))

        # Status line: mode, service state, the daemon's hold speed, hottest CPU.
        state = self.service_state
        running = state in ("active", "activating", "reloading")
        s = Text()
        s.append("Mode: ")
        mode_style = {"daemon": "bold", "bmc": "bold cyan", "manual": "bold yellow"}[self.mode]
        s.append(MODE_LABELS[self.mode], style=mode_style)
        if self.mode == "manual":
            s.append(" ")
            s.append(f"at {self.slider.value}%", style="bold yellow")
        s.append(f"{gap}Service: ")
        s.append(state, style={"active": "green", "failed": "red"}.get(state, "yellow"))
        if running and self.mode in ("bmc", "manual"):
            s.append("\u00a0(standing down)", style="grey62")
        elif not running and self.mode == "daemon":
            s.append("\u00a0(no controller: BMC curve in charge)", style="grey62")
        s.append(f"{gap}Hold: ")
        if self.cfg.path is None:
            s.append("n/a", style="grey62")
        else:
            s.append(f"{self.hold_pct}%", style="bold")
            if self.hold_unapplied:
                s.append(
                    "\u00a0(saved: restart to apply)" if running else "\u00a0(saved: applies on next start)",
                    style="yellow",
                )
        s.append(f"{gap}CPU max: ")
        if self.max_cpu is None:
            s.append("?", style="red")
        else:
            s.append(f"{self.max_cpu}°C", style="red" if self.max_cpu >= self.cfg.threshold else "")
        s.append(f" / {self.cfg.threshold}°C")
        self.query_one("#status", Static).update(s)

        for name in ("daemon", "bmc", "manual"):
            self.query_one(f"#mode-{name}", Button).set_class(self.mode == name, "active")
        # The AUTO box title carries the meaning, so the short labels lose nothing.
        self.query_one("#mode-daemon", Button).label = "Daemon" if narrow else "Daemon control"
        self.query_one("#mode-bmc", Button).label = "BMC" if narrow else "BMC control"

        # The daemon group: its state is in the top bar, so these are just buttons.
        save = self.query_one("#hold-save", Button)
        save.label = f"Set hold {self.slider.value}%"
        save.disabled = self.cfg.path is None or self.slider.value == self.hold_pct

        toggle = self.query_one("#svc-toggle", Button)
        toggle.label = "STOP" if running else "START"
        toggle.disabled = state == "n/a"
        self.query_one("#svc-restart", Button).disabled = state == "n/a"

    # -- events -----------------------------------------------------------

    def on_resize(self, event: events.Resize) -> None:
        self._refresh_all()

    def on_slider_changed(self, event: Slider.Changed) -> None:
        self._refresh_all()
        if self.mode == "manual":
            if self._apply_timer is not None:
                self._apply_timer.stop()
            # Debounce: dragging the slider should not fire a command per cell.
            self._apply_timer = self.set_timer(0.5, self._apply_speed)

    async def on_button_pressed(self, event: Button.Pressed) -> None:
        bid = event.button.id or ""
        if bid.startswith("mode-"):
            await self.set_mode(bid.removeprefix("mode-"))
        elif bid == "hold-save":
            await self.save_hold()
        elif bid in ("svc-toggle", "svc-restart"):
            running = self.service_state in ("active", "activating", "reloading")
            action = "restart" if bid == "svc-restart" else "stop" if running else "start"
            # A worker, so the UI stays responsive while systemctl runs.
            self.run_worker(self.service_action(action), group="service")
        elif bid == "bump-up":
            self.slider.user_set(self.slider.value + 5)
        elif bid == "bump-down":
            self.slider.user_set(self.slider.value - 5)
        elif bid.startswith("preset-"):
            self.slider.user_set(int(bid.removeprefix("preset-")))
        self.slider.focus()

    async def action_set_mode(self, mode: str) -> None:
        await self.set_mode(mode)

    def action_scroll_by(self, lines: int) -> None:
        self.screen.scroll_relative(y=lines, animate=False)

    def action_scroll_page(self, direction: int) -> None:
        if direction > 0:
            self.screen.scroll_page_down(animate=False)
        else:
            self.screen.scroll_page_up(animate=False)

    def action_scroll_edge(self, where: str) -> None:
        if where == "home":
            self.screen.scroll_home(animate=False)
        else:
            self.screen.scroll_end(animate=False)

    def action_bump(self, delta: int) -> None:
        self.slider.user_set(self.slider.value + delta)

    async def on_slider_adjusted(self, event: Slider.Adjusted) -> None:
        # Asking for a fan speed means taking the fans over, so go to Manual. The
        # usual checks still apply: if it is refused the slider just moves the target.
        if self.mode != "manual":
            await self.set_mode("manual")


if __name__ == "__main__":
    FanApp().run()
