        # One footer entry for both: the footer must fit an 80-column terminal.
        Binding("plus,equals_sign", "bump(5)", "±5%", key_display="+/-"),
        Binding("minus", "bump(-5)", "-5%", show=False),
        Binding("c", "toggle_compact", "Compact"),
        # The layout is taller than a 24-row terminal, so the screen scrolls. One
        # footer entry stands for all of these.
        Binding("down", "scroll_by(1)", "Scroll", key_display="↑↓"),
        Binding("up", "scroll_by(-1)", "Scroll up", show=False),
