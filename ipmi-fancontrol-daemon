#!/bin/bash
# Temperature-aware IPMI fan control for Dell PowerEdge / iDRAC.
#
# Holds the fans at a fixed low duty while the CPUs are cool (re-sending the
# setting every poll, in case the BMC has reverted on its own), and hands control
# back to the BMC's automatic curve once they get hot, so there is still a
# thermal response under load. This is the native equivalent of the
# tigerblue77/dell_idrac_fan_controller container, without needing Docker.
#
# Run under ipmi-fancontrol.service. Configuration lives in
# conf/ipmi-fancontrol.conf (see conf/ipmi-fancontrol.conf.example).
#
# Another controller (ipmi-fancontrol-tui) can take over the fans by writing its
# PID to the override file. While that PID is alive the daemon stands down and
# touches nothing; if the controller exits or dies, the daemon resumes by itself.

set -uo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
CONFIG=${IPMI_FANCONTROL_CONFIG:-$SCRIPT_DIR/conf/ipmi-fancontrol.conf}

if [[ ! -r "$CONFIG" ]]; then
    echo "Error: cannot read $CONFIG" >&2
    echo "Copy conf/ipmi-fancontrol.conf.example there and fill it in." >&2
    exit 1
fi

# shellcheck source=/dev/null
. "$CONFIG"

: "${IPMI_INTERFACE:=open}"
: "${FAN_SPEED:=0x15}"
: "${CPU_TEMP_THRESHOLD:=70}"
: "${CPU_TEMP_HYSTERESIS:=5}"
: "${CHECK_INTERVAL:=60}"
: "${DISABLE_THIRD_PARTY_PCIE_COOLING_RESPONSE:=false}"
: "${OVERRIDE_FILE:=/run/ipmi-fancontrol.override}"

RESUME_AT=$((CPU_TEMP_THRESHOLD - CPU_TEMP_HYSTERESIS))

# Build the ipmitool invocation once. The local "open" interface needs no
# credentials and no network, so it is the better choice for a polling loop;
# lanplus stays available for reaching a BMC over the network.
if [[ "$IPMI_INTERFACE" == "lanplus" ]]; then
    : "${IPMI_HOST:?not set in $CONFIG}"
    : "${IPMI_USER:?not set in $CONFIG}"
    : "${IPMI_PASSWORD:?not set in $CONFIG}"
    export IPMI_PASSWORD
    IPMITOOL=(ipmitool -I lanplus -H "$IPMI_HOST" -U "$IPMI_USER" -E)
else
    IPMITOOL=(ipmitool -I open)
fi

# stdout goes to the journal under systemd.
log() { echo "$*"; }

set_manual() {
    "${IPMITOOL[@]}" raw 0x30 0x30 0x01 0x00 >/dev/null &&
        "${IPMITOOL[@]}" raw 0x30 0x30 0x02 0xff "$FAN_SPEED" >/dev/null
}

set_auto() {
    "${IPMITOOL[@]}" raw 0x30 0x30 0x01 0x01 >/dev/null
}

# The third-party PCIe card cooling response is a persistent BMC setting, so
# whatever we change at startup has to be put back when we stop. The last data
# byte is the switch: 0x01 disables Dell's response, 0x00 enables it. Reading it
# back with "raw 0x30 0xce 0x01 0x16 0x05 0x00 0x00 0x00" returns the same
# bytes, so 16 05 00 00 00 05 00 01 00 00 means disabled.
set_pcie_response() {
    "${IPMITOOL[@]}" raw 0x30 0xce 0x00 0x16 0x05 0x00 0x00 0x00 0x05 0x00 "$1" 0x00 0x00 >/dev/null 2>&1
}

# The BMC can drop out of manual mode on its own (observed on a PowerEdge T630
# with no SEL entry and nothing in the journal), after which the fans silently
# follow the automatic curve while we still believe they are pinned. There is no
# way to read the mode back, so re-send it on every poll while we want manual.
# It is idempotent, and logs only on failure.
reassert_manual() {
    set_manual || log "Warning: failed to re-assert manual fan control."
}

# True while another controller has claimed the fans. The override file holds its
# PID, so a controller that crashes without cleaning up releases the fans anyway.
OVERRIDE_PID=""
override_active() {
    OVERRIDE_PID=""
    [[ -r "$OVERRIDE_FILE" ]] || return 1
    local pid=""
    read -r pid < "$OVERRIDE_FILE" || [[ -n "$pid" ]] || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
    OVERRIDE_PID=$pid
}

# Highest CPU temperature in degrees C, or empty if none could be read.
# CPU sensors are entity 3.x; 7.x is the system board (inlet/exhaust).
max_cpu_temp() {
    "${IPMITOOL[@]}" sdr type temperature 2>/dev/null | awk -F'|' '
        $4 ~ /^[[:space:]]*3\./ {
            if (match($5, /-?[0-9]+/)) {
                t = substr($5, RSTART, RLENGTH) + 0
                if (!seen || t > max) max = t
                seen = 1
            }
        }
        END { if (seen) print max }
    '
}

MODE=""

cleanup() {
    log "Stopping: returning fan control to the BMC automatic curve."
    set_auto || log "Warning: failed to restore automatic fan control."
    if [[ "$DISABLE_THIRD_PARTY_PCIE_COOLING_RESPONSE" == "true" ]]; then
        if set_pcie_response 0x00; then
            log "Re-enabled the third-party PCIe card default cooling response."
        else
            log "Warning: failed to re-enable the third-party PCIe cooling response."
        fi
    fi
    exit 0
}
trap cleanup TERM INT

if [[ "$DISABLE_THIRD_PARTY_PCIE_COOLING_RESPONSE" == "true" ]]; then
    if set_pcie_response 0x01; then
        log "Disabled the third-party PCIe card default cooling response."
    else
        log "Warning: could not disable the third-party PCIe cooling response."
    fi
fi

log "Starting: fans held at $FAN_SPEED below ${CPU_TEMP_THRESHOLD}C, automatic at or above it, re-engaging at ${RESUME_AT}C. Polling every ${CHECK_INTERVAL}s over $IPMI_INTERFACE."

# One pass of the control loop: read the CPUs, then pick manual or automatic.
poll_once() {
    local temp
    temp=$(max_cpu_temp)

    if [[ -z "$temp" ]]; then
        # Fail safe: if the temperature cannot be read, let the BMC cool the box.
        if [[ "$MODE" != "auto" ]]; then
            log "Cannot read CPU temperature; failing safe to automatic fan control."
            set_auto && MODE="auto"
        fi
    elif (( temp >= CPU_TEMP_THRESHOLD )); then
        if [[ "$MODE" != "auto" ]]; then
            log "CPU at ${temp}C, at or above ${CPU_TEMP_THRESHOLD}C: handing control to the BMC automatic curve."
            set_auto && MODE="auto"
        fi
    elif [[ -z "$MODE" ]] || (( temp <= RESUME_AT )); then
        # The -z test makes the very first pass decide rather than drift, even
        # if we start up inside the hysteresis band.
        if [[ "$MODE" != "manual" ]]; then
            log "CPU at ${temp}C, at or below ${RESUME_AT}C: holding fans at $FAN_SPEED."
            set_manual && MODE="manual"
        else
            reassert_manual
        fi
    elif [[ "$MODE" == "manual" ]]; then
        # Inside the hysteresis band we deliberately keep whatever mode we are
        # in, but still re-assert manual: see reassert_manual.
        reassert_manual
    fi
}

STANDING_DOWN=0
while true; do
    if override_active; then
        if (( ! STANDING_DOWN )); then
            log "Override held by PID ${OVERRIDE_PID}: standing down, leaving the fans alone."
            STANDING_DOWN=1
        fi
        # Forget our mode so the first pass after the override re-decides from
        # scratch, whatever state the other controller left the fans in.
        MODE=""
    else
        if (( STANDING_DOWN )); then
            log "Override released: resuming control."
            STANDING_DOWN=0
        fi
        poll_once
    fi

    # Backgrounded so that SIGTERM interrupts the wait instead of being deferred
    # until the sleep finishes.
    sleep "$CHECK_INTERVAL" &
    wait $!
done
