# Credentials for the BMC user driving ipmi-fancontrol-manual / ipmi-fancontrol-auto.
#
# Copy to conf/ipmi-fancontrol.conf next to the scripts and lock it down:
#   cp conf/ipmi-fancontrol.conf.example conf/ipmi-fancontrol.conf
#   chmod 0600 conf/ipmi-fancontrol.conf
#
# The scripts look for it relative to their own location, so this works both in a
# checkout and deployed at /opt/ergosteur. Override with IPMI_FANCONTROL_CONFIG.

IPMI_HOST=169.254.0.1
IPMI_USER=fancontrol

# Read by ipmitool -E, so it never appears in the process table.
IPMI_PASSWORD=changeme

# Fan speed applied in manual mode, as a raw hex byte (0x15 = 21%).
FAN_SPEED=0x15
