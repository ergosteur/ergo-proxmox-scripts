[Unit]
Description=Temperature-aware IPMI fan control
Documentation=file:/opt/ergosteur/ipmi-fancontrol-daemon
# Only needed when conf sets IPMI_INTERFACE=lanplus; harmless for the local
# "open" interface.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/ergosteur/ipmi-fancontrol-daemon
# The daemon restores the automatic curve on SIGTERM. This is the backstop for
# the case where it is killed outright and its trap never runs.
ExecStopPost=/opt/ergosteur/ipmi-fancontrol-auto
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
